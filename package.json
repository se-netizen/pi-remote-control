{
  "name": "@se-netizen/pi-remote-control",
  "version": "0.1.0",
  "description": "Control your Pi coding-agent sessions from your phone or browser: live chat, files and photos, background sessions, over Tailscale or encrypted Wi-Fi.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "remote-control",
    "tailscale",
    "mobile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/se-netizen/pi-remote-control.git"
  },
  "homepage": "https://github.com/se-netizen/pi-remote-control#readme",
  "bugs": {
    "url": "https://github.com/se-netizen/pi-remote-control/issues"
  },
  "type": "module",
  "bin": {
    "pi-remote-control": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "dist/web/",
    "src/",
    "extensions/"
  ],
  "pi": {
    "extensions": [
      "./extensions/remote-control.ts"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "pi:install": "pi install .",
    "pi:uninstall": "pi remove .",
    "dev": "tsx watch src/cli.ts start",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "qrcode-generator": "2.0.4"
  }
}
